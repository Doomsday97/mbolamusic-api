// MbôláMusic - Esquema de base de datos
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------

enum Role {
  LISTENER
  ARTIST
  ADMIN
}

enum SubscriptionType {
  ARTIST_MONTHLY     // 10.000 FCFA/mes
  ARTIST_FREE        // 1 mes gratis para artistas nuevos
  LISTENER_FREE      // 1 mes gratis para oyentes nuevos
  LISTENER_MONTHLY   // 2.000 FCFA/mes
  LISTENER_YEARLY    // 12.000 FCFA/año (10.000 FCFA la primera vez)
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentMethod {
  SIM_BALANCE        // Saldo SIM / Mobile Money
  BANK_TRANSFER      // Transferencia bancaria
  CARD               // Tarjeta Visa/Mastercard
  WALLET             // Monedero interno
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  VERIFYING          // transferencia en revisión
}

enum PaymentPurpose {
  ARTIST_SUBSCRIPTION
  LISTENER_SUBSCRIPTION
  LISTENER_SUBSCRIPTION_YEARLY
  PER_PLAY
  PER_DOWNLOAD
  WALLET_TOPUP
  WALLET_WITHDRAW
  PLATFORM_WITHDRAW
}

// ------------------------------------------------------------------
// USUARIOS
// ------------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String
  role          Role      @default(LISTENER)
  previousRole  Role?     // rol antes de ser designado ADMIN, para restaurarlo al degradar
  isSuperAdmin  Boolean   @default(false) // solo el admin principal puede designar/quitar otros admins
  isSilenced    Boolean   @default(false) // el admin principal oculta su presencia/actividad (no bloquea su acceso)

  username      String    @unique
  country       String    @default("Guinea Ecuatorial")
  city          String?
  avatarUrl     String?
  favoriteGenres String[]  @default([])

  walletBalance Int       @default(0) // saldo monedero en FCFA
  fcmToken      String?   // token de notificaciones push (Firebase Cloud Messaging)

  isVerified    Boolean   @default(false) // email/phone verificado
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  deletedAt       DateTime? // cuenta eliminada por el admin (anonimizada, bloqueada; ver Política de Privacidad §4)
  deletionReason  String?

  artistProfile    ArtistProfile?
  subscriptions    Subscription[]
  payments         Payment[]
  plays            Play[]
  downloads        Download[]
  playlists        Playlist[]
  trackLikes       TrackLike[]
  following        Follow[]           @relation("Follower")
  followers        Follow[]           @relation("Following")
  referralsMade    Referral[]         @relation("Referrer")
  referralSignup   ReferralSignup?    @relation("ReferredSignup")
  referralDiscountCredits ReferralDiscountCredit[]
  notifications    Notification[]
  securityQuestions SecurityQuestion[]
  chatMessages     ChatMessage[]
  monthlyDistributions MonthlyDistribution[]
  copyrightClaimsReported CopyrightClaim[]

  @@index([role])
}

model SecurityQuestion {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   String
  answerHash String
  createdAt  DateTime @default(now())

  @@unique([userId, question])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   // non-admin participant of the conversation
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAdmin Boolean  @default(false)  // true = sent by admin, false = sent by user
  body      String
  mediaUrl  String?  // foto o video adjunto (opcional)
  mediaType String?  // "image" | "video"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // NEW_FOLLOWER | NEW_TRACK | PAYMENT_CONFIRMED | PAYMENT_REJECTED
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model ArtistProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  artistName      String
  realName        String?
  bio             String?
  idDocumentUrl   String?  // documento de identidad para verificación
  idVerified      Boolean  @default(false)
  socialLinks     Json?    // { instagram, facebook, tiktok, youtube, twitter, whatsapp }

  totalEarnings   Int      @default(0) // ganancias acumuladas en FCFA (no retiradas)

  tracks          Track[]
  plays           Play[]
  monthlyEarnings ArtistMonthlyEarning[]
  createdAt       DateTime @default(now())
}

// ------------------------------------------------------------------
// MÚSICA
// ------------------------------------------------------------------

model Track {
  id            String   @id @default(uuid())
  artistId      String
  artist        ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  title         String
  genre         String
  coverUrl      String?
  audioUrl      String
  lyrics        String?
  album         String?
  durationSec   Int      @default(0)
  releaseDate   DateTime @default(now())

  // Si el artista no paga su suscripción, su música se oculta (no se borra)
  isPublished   Boolean  @default(true)

  // Borrado suave: al eliminar una canción se marca aquí en vez de borrarla al
  // instante. Se puede restaurar dentro de las 48h siguientes; pasado ese plazo,
  // un job programado la borra definitivamente (BD + archivos en R2).
  deletedAt     DateTime?

  playCount     Int      @default(0)
  downloadCount Int      @default(0)
  likeCount     Int      @default(0)

  plays         Play[]
  downloads     Download[]
  likes         TrackLike[]
  playlistItems PlaylistItem[]

  createdAt     DateTime @default(now())

  copyrightClaims CopyrightClaim[]

  @@index([genre])
  @@index([isPublished])
  @@index([deletedAt])
}

// Registro de reclamaciones de copyright recibidas sobre una canción, y su
// seguimiento (contactar al artista/usuario que la subió, resolver, etc.).
model CopyrightClaim {
  id            String   @id @default(uuid())
  trackId       String
  track         Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Usuario logueado que envió el formulario (artista u oyente desde Ajustes,
  // o el propio admin al registrarla manualmente). Null si el usuario borra
  // su cuenta después -- la reclamación se conserva igual.
  reporterId    String?
  reporter      User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  claimantName  String
  claimantEmail String
  reason        String

  status        String   @default("OPEN") // OPEN, CONTACTED, RESOLVED, DISMISSED
  adminNotes    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  contactedAt   DateTime?
  resolvedAt    DateTime?

  @@index([trackId])
  @@index([status])
}

// ------------------------------------------------------------------
// SUSCRIPCIONES
// ------------------------------------------------------------------

model Subscription {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        SubscriptionType
  status      SubscriptionStatus @default(ACTIVE)
  startDate   DateTime @default(now())
  endDate     DateTime
  autoRenew   Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([userId, status])
}

// ------------------------------------------------------------------
// PAGOS
// ------------------------------------------------------------------

model Payment {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount        Int      // en FCFA
  method        PaymentMethod
  status        PaymentStatus  @default(PENDING)
  purpose       PaymentPurpose

  // Referencia externa de la pasarela o comprobante de transferencia
  externalRef   String?
  // Para pay-per-use: a qué track se asocia
  trackId       String?
  // Reparto calculado
  artistShare   Int      @default(0)
  platformShare Int      @default(0)

  // Crédito de descuento por referidos reservado para este pago (si lo hay).
  // Se marca "usado" (ReferralDiscountCredit.usedAt) solo si el pago llega a
  // COMPLETED; si termina en FAILED queda libre para un intento posterior.
  discountCreditId String?

  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([status])
}

// ------------------------------------------------------------------
// REPRODUCCIONES Y DESCARGAS
// ------------------------------------------------------------------

model Play {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artistId  String?
  artist    ArtistProfile? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  // true si fue cubierta por suscripción, false si fue pago por reproducción
  bySubscription Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([trackId])
  @@index([artistId])
}

model Download {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // PURCHASED: pago único de 200 FCFA, queda descargada para siempre hasta
  // que el usuario la borre. SUBSCRIPTION: gratis mientras dure la
  // suscripción del oyente, con tope mensual (ver business.js); no cuenta
  // como "ya comprada" para el flujo de pago por descarga.
  source    String   @default("PURCHASED")

  @@index([userId])
  @@index([trackId])
  @@index([userId, source, createdAt])
}

model TrackLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
  @@index([trackId])
  @@index([userId])
}

// ------------------------------------------------------------------
// LISTAS DE REPRODUCCIÓN
// ------------------------------------------------------------------

model Playlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  items     PlaylistItem[]
  createdAt DateTime @default(now())
}

model PlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([playlistId, trackId])
}

// ------------------------------------------------------------------
// SOCIAL
// ------------------------------------------------------------------

model Follow {
  id          String @id @default(uuid())
  followerId  String
  follower    User   @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// ------------------------------------------------------------------
// REFERIDOS (icono de regalo)
// ------------------------------------------------------------------

model Referral {
  id          String @id @default(uuid())
  code        String @unique
  referrerId  String
  referrer    User   @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  signups ReferralSignup[]
}

// Un registro por cada usuario nuevo que se une con el código de un referidor
// (a diferencia del viejo campo Referral.referredId, que solo soportaba UNO
// por código para siempre). "counted" se marca true quien completa su
// PRIMERA suscripción de pago (mensual o anual) -- solo esas cuentan para
// el tope de 5 del descuento; las renovaciones posteriores no se recuentan.
model ReferralSignup {
  id             String   @id @default(uuid())
  referralId     String
  referral       Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referrerId     String
  referredUserId String   @unique
  referredUser   User     @relation("ReferredSignup", fields: [referredUserId], references: [id], onDelete: Cascade)
  counted        Boolean  @default(false)
  countedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([referrerId, counted])
}

// Crédito de 50% de descuento acumulado por un referidor al alcanzar cada
// múltiplo de 5 referidos que pagaron su primera suscripción. Se consumen
// de a uno, en orden de creación, en la próxima suscripción que pague el
// propio referidor.
model ReferralDiscountCredit {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId, usedAt])
}

// ------------------------------------------------------------------
// REPARTO MENSUAL POR SUSCRIPCIÓN
// ------------------------------------------------------------------

// Configuración mensual del reparto (umbrales y porcentajes ajustables)
model MonthlyConfig {
  id                String   @id @default(uuid())
  month             String   @unique // "YYYY-MM"
  subscriptionValue Int      @default(2000) // FCFA por suscriptor
  adminPct          Int      @default(30)   // porcentaje plataforma
  artistPct         Int      @default(70)   // porcentaje artistas
  minPlaysThreshold Int      @default(1000) // reproducciones globales mínimas del artista
  createdAt         DateTime @default(now())
}

// Registro agregado de las ganancias del administrador por mes
model AdminMonthlyEarning {
  id                String   @id @default(uuid())
  month             String   @unique // "YYYY-MM"
  totalSubscribers  Int
  totalFund         Int      // S × 2000 FCFA
  adminAmount       Int      // 30% de totalFund
  artistPool        Int      // 70% de totalFund (tope máximo)
  distributedAmount Int      // realmente repartido entre artistas elegibles
  reserveAmount     Int      // no distribuido (umbral no alcanzado / sin escuchas)
  processedAt       DateTime @default(now())
}

model MonthlyDistribution {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         String   // formato "YYYY-MM"
  totalPlays    Int
  artistPool    Int      @default(1400) // FCFA dirigidos a artistas (neto después de umbral)
  adminShare    Int      @default(600)  // FCFA de la plataforma
  reserveAmount Int      @default(0)    // FCFA no distribuidos (umbral / sin escuchas)
  processedAt   DateTime @default(now())
  artistEarnings ArtistMonthlyEarning[]

  @@unique([userId, month])
  @@index([month])
}

model ArtistMonthlyEarning {
  id             String   @id @default(uuid())
  distributionId String
  distribution   MonthlyDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  artistId       String
  artist         ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  month          String
  playsCount     Int
  amount         Int      // FCFA redondeados
  isPaid         Boolean  @default(false)
  paidAt         DateTime?

  @@unique([distributionId, artistId])
  @@index([artistId, month])
  @@index([month])
}

// ------------------------------------------------------------------
// PUBLICIDAD
// ------------------------------------------------------------------

model Ad {
  id          String   @id @default(uuid())
  title       String
  description String?
  linkUrl     String?
  imageUrl    String?
  mediaUrl    String?  // base64 data URL (imagen ≤2 MB) o URL directa (video)
  mediaType   String?  // "image" | "video"
  // Posición: "web-top" | "web-mid" | "web-bottom" | "app-discover" | "app-library" | "app-all"
  slot        String
  bgColor     String   @default("#1A1200")
  accentColor String   @default("#F59E0B")
  icon        String   @default("star")   // nombre simbólico para el frontend
  isActive    Boolean  @default(true)
  priority    Int      @default(0)        // mayor = se muestra primero
  clicks      Int      @default(0)
  impressions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slot, isActive])
}
